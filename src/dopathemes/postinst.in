#!/bin/sh
# DopaThemes (com.mymculture.dopathemes)
# Writes the themes and their icons into every installed Dopamine app (Dopamine, Trollamine,
# duplicated copies), then has TrollStore re-register the apps so iOS sees the new icons.
# Everything ends up inside the app itself, so the themes stay when you're not jailbroken.
# @PREFIX@ is filled in by build.sh.
PREFIX="@PREFIX@"
SHARE="$PREFIX/Library/DopaThemes"
PATCH="$PREFIX/usr/libexec/dopathemes-patch"
LOG=/var/tmp/dopathemes.log
export PATH="$PREFIX/usr/bin:$PREFIX/bin:$PREFIX/usr/sbin:$PREFIX/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

[ "$1" = "configure" ] || exit 0
say() { echo "DopaThemes: $*"; }

# Leftover from DopaThemes 1.x (the runtime tweak).
rm -f /var/mobile/Library/Preferences/com.mymculture.dopathemes.icons.plist

find_engine() {
    for app in TrollStore.app Trollamine.app; do
        for h in /var/containers/Bundle/Application/*/"$app"/trollstorehelper; do
            if [ -f "$h" ]; then echo "$h"; return 0; fi
        done
    done
    return 1
}

OUT=$("$PATCH" apply "$SHARE" 2>>"$LOG")
CODE=$?
echo "$OUT" >>"$LOG"
echo "$OUT" | while read -r line; do [ -n "$line" ] && say "$line"; done
if [ "$CODE" = "2" ]; then
    say "Dopamine 2.x isn't installed, so there was nothing to add themes to."
    say "Install Dopamine, then reinstall DopaThemes."
    exit 0
fi

ENGINE=$(find_engine)
if [ -n "$ENGINE" ] && "$ENGINE" refresh >>"$LOG" 2>&1; then
    say "Done. Close Dopamine from the app switcher, reopen it, then go to Settings > Theme."
else
    say "Themes added, but TrollStore couldn't refresh the app list, so the new icons may not work yet."
    say "Open TrollStore > Settings > Refresh App Registrations, then reopen Dopamine."
fi
[ "$CODE" = "0" ] || say "Some copies couldn't be updated. Log: $LOG"
say "If you update Dopamine later, reinstall DopaThemes to put the themes back."
exit 0
