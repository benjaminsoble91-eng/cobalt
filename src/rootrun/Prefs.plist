		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>label</key>
			<string>Apps</string>
			<key>class</key>
			<string>RRAppsController</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Running an app as root removes the sandbox protection that normally keeps it in its own container. Only switch on apps you trust. Force-quit an app after changing its switch so it picks up the change on next launch.

RootRun 1.0 from Cobalt.</string>
		</dict>
