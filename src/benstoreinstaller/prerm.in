#!/bin/sh
# Benstore Installer: when the app was installed as a jailbreak app (no TrollStore),
# removing this package removes the app too. A TrollStore-owned copy is left alone.
PREFIX="@PREFIX@"
SHARE="$PREFIX/usr/share/benstoreinstaller"
JBDEST="$PREFIX/Applications/Benstore.app"
export PATH="$PREFIX/usr/bin:$PREFIX/bin:$PREFIX/usr/sbin:$PREFIX/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

case "$1" in
    remove|purge) ;;
    *) exit 0 ;;
esac

if [ -f "$SHARE/.jailbreak-app" ]; then
    command -v uicache >/dev/null 2>&1 && uicache -u "$JBDEST" >/dev/null 2>&1
    rm -rf "$JBDEST" "$SHARE/.jailbreak-app"
fi
exit 0
