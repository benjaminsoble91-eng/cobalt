#!/bin/sh
# Splice: sign the app with its entitlements and add it to the Home Screen.
PREFIX="@PREFIX@"
APP="$PREFIX/Applications/Splice.app"
ENTS="$PREFIX/usr/share/splice/ents.plist"
export PATH="$PREFIX/usr/bin:$PREFIX/bin:$PREFIX/usr/sbin:$PREFIX/sbin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

[ "$1" = "configure" ] || exit 0

if ! ldid -S"$ENTS" "$APP/Splice"; then
    echo "Splice: signing with ldid failed. Reinstall ldid, then reinstall this package."
    exit 1
fi
ldid -S "$APP/Shim/CydiaSubstrate.framework/CydiaSubstrate" >/dev/null 2>&1 || true
uicache -p "$APP" >/dev/null 2>&1 || uicache -a >/dev/null 2>&1
echo "Splice is on your Home Screen."
exit 0
